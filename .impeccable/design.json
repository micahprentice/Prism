    {
      "name": "Approve",
      "kind": "button",
      "refersTo": "button-approve",
      "description": "The one lit button on a screen: action line plus a 12.5px reassurance line.",
      "html": "<button class=\"ds-approve\"><span>Approve Signature</span><span class=\"ds-approve-sub\">pay $500 deposit · pick your install day</span></button>",
      "css": ".ds-approve{appearance:none;border:0;cursor:pointer;width:100%;min-height:60px;padding:10px 20px;border-radius:12px;background:#FFD98F;color:#1A1304;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family:Archivo,Helvetica Neue,Arial,sans-serif;font-weight:600;font-size:16.5px;letter-spacing:-.01em;line-height:1.2;box-shadow:0 10px 30px -14px rgba(255,217,143,.55);transition:transform .18s cubic-bezier(.2,.8,.2,1),background .2s,box-shadow .25s}.ds-approve:hover{background:#FFE3A8;box-shadow:0 14px 36px -14px rgba(255,217,143,.7)}.ds-approve:active{transform:translateY(1px) scale(.995);background:#F2BE5C}.ds-approve:focus-visible{outline:2px solid #FFD98F;outline-offset:3px}.ds-approve-sub{font-weight:500;font-size:12.5px;opacity:.72}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action on owner screens.",
      "html": "<a class=\"ds-ghost\" href=\"#\">See what Sarah sees <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M2 7h10M8 3l4 4-4 4\"/></svg></a>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border:1px solid rgba(238,241,248,.12);border-radius:8px;background:none;color:#A6AEC2;font-family:Archivo,Helvetica Neue,Arial,sans-serif;font-size:13px;font-weight:500;text-decoration:none;cursor:pointer;transition:border-color .2s,color .2s}.ds-ghost:hover{border-color:#78829B;color:#EEF1F8}.ds-ghost:focus-visible{outline:2px solid #FFD98F;outline-offset:3px}"
    },
    {
      "name": "Tier dial",
      "kind": "custom",
      "refersTo": "dial",
      "description": "Three-segment radiogroup; a lamp-wash indicator slides under the selected tier.",
      "html": "<div class=\"ds-dial\" role=\"radiogroup\" style=\"--dial-i:1\"><button class=\"ds-dial-opt\" role=\"radio\" aria-checked=\"false\"><span class=\"ds-dial-name\">Classic</span><span class=\"ds-dial-price\">$1,500</span></button><button class=\"ds-dial-opt is-on\" role=\"radio\" aria-checked=\"true\"><span class=\"ds-dial-name\">Signature</span><span class=\"ds-dial-price\">$2,450</span></button><button class=\"ds-dial-opt\" role=\"radio\" aria-checked=\"false\"><span class=\"ds-dial-name\">Showcase</span><span class=\"ds-dial-price\">$4,200</span></button><span class=\"ds-dial-ind\" aria-hidden=\"true\"></span></div>",
      "css": ".ds-dial{position:relative;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid rgba(238,241,248,.12);border-radius:10px;padding:3px;background:#0C1020;font-family:Archivo,Helvetica Neue,Arial,sans-serif}.ds-dial-ind{position:absolute;top:3px;bottom:3px;left:3px;width:calc((100% - 6px)/3);background:rgba(255,217,143,.13);border:1px solid rgba(255,217,143,.6);border-radius:7px;transform:translateX(calc(var(--dial-i) * 100%));transition:transform .45s cubic-bezier(.2,.8,.2,1)}.ds-dial-opt{position:relative;z-index:1;appearance:none;border:0;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:1px;min-height:54px;padding:8px 4px;border-radius:7px;color:#A6AEC2;transition:color .3s}.ds-dial-opt:hover{color:#EEF1F8}.ds-dial-opt.is-on{color:#FFD98F}.ds-dial-opt:focus-visible{outline:2px solid #FFD98F;outline-offset:-3px}.ds-dial-name{font-weight:600;font-size:15px}.ds-dial-price{font-size:12.5px;opacity:.78}"
    },
    {
      "name": "Scope line",
      "kind": "card",
      "refersTo": "slot-booked",
      "description": "One line of the quote's scope: lamp, name, measure; detail unfolds when lit.",
      "html": "<ol class=\"ds-scope\"><li class=\"ds-scope-item is-lit\"><span class=\"ds-lamp\"></span><span class=\"ds-scope-name\">Front roofline</span><span class=\"ds-scope-measure\">112 ft of C9</span><p class=\"ds-scope-detail\">Commercial LED C9 bulbs on custom-cut wire, clipped to the eave. Nothing nailed, nothing stapled.</p></li><li class=\"ds-scope-item\"><span class=\"ds-lamp\"></span><span class=\"ds-scope-name\">Maple trunk &amp; limb wrap</span><span class=\"ds-scope-measure\">≈1,200 ft of minis</span><button class=\"ds-scope-up\">Add with Showcase · +$1,750</button></li></ol>",
      "css": ".ds-scope{list-style:none;margin:0;padding:0;font-family:Archivo,Helvetica Neue,Arial,sans-serif;font-variant-numeric:tabular-nums}.ds-scope-item{position:relative;display:grid;grid-template-columns:18px 1fr auto;column-gap:12px;align-items:baseline;padding:12px 0;border-bottom:1px solid rgba(238,241,248,.07);color:#78829B;transition:color .4s}.ds-scope-item.is-lit{color:#EEF1F8}.ds-lamp{width:8px;height:8px;border-radius:50%;justify-self:center;align-self:center;background:#121729;border:1px solid rgba(238,241,248,.12)}.is-lit .ds-lamp{background:#FFD98F;border-color:#FFD98F;box-shadow:0 0 0 3px rgba(255,217,143,.22),0 0 14px 2px rgba(255,217,143,.35)}.ds-scope-name{font-weight:500;font-size:15px}.ds-scope-measure{font-size:13px;color:#78829B;white-space:nowrap}.is-lit .ds-scope-measure{color:#A6AEC2}.ds-scope-detail{grid-column:2/-1;margin:3px 0 0;font-size:13.5px;line-height:1.5;color:#A6AEC2}.ds-scope-up{position:absolute;right:0;top:13px;appearance:none;border:0;background:none;padding:0;cursor:pointer;font:inherit;font-size:12.5px;font-weight:500;color:#78829B;text-decoration:underline;text-underline-offset:3px;opacity:0;transition:opacity .2s}.ds-scope-item:not(.is-lit):hover .ds-scope-up,.ds-scope-up:focus-visible{opacity:1;color:#FFD98F}.ds-scope-item:not(.is-lit):hover .ds-scope-measure{opacity:0}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Payment-sheet text field.",
      "html": "<label class=\"ds-field\"><span>Name on card</span><input value=\"Sarah Whitfield\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:Archivo,Helvetica Neue,Arial,sans-serif;font-size:13px;color:#A6AEC2}.ds-field input{height:48px;padding:0 14px;border-radius:10px;border:1px solid rgba(238,241,248,.12);background:#070A14;color:#EEF1F8;font:inherit;font-size:15px}.ds-field input:focus-visible{outline:2px solid #FFD98F;outline-offset:2px;border-color:#FFD98F}"
