    {
      "name": "Calendar slot",
      "kind": "chip",
      "refersTo": "slot-hold",
      "description": "An install window: booked, held for a quote, or booked in this session.",
      "html": "<div class=\"ds-slots\"><div class=\"ds-slot is-booked\"><small>8:00 AM</small><span><b>Garza</b><span class=\"ds-crew\">Crew A</span></span></div><div class=\"ds-slot is-hold\"><small>12:30 PM</small><span>Held · Whitfield</span></div><div class=\"ds-slot is-new\"><small>8:00 AM</small><span><b>Whitfield</b> · Crew B</span></div></div>",
      "css": ".ds-slots{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-family:Archivo,Helvetica Neue,Arial,sans-serif}.ds-slot{min-height:58px;border-radius:7px;padding:8px 9px;font-size:12.5px;line-height:1.3;border:1px solid rgba(238,241,248,.07);background:#0C1020;color:#78829B;display:flex;flex-direction:column;justify-content:space-between;gap:4px}.ds-slot small{font-size:11px;letter-spacing:.04em;text-transform:uppercase;font-weight:600}.ds-slot.is-booked{background:#1A2036;border-color:transparent;color:#EEF1F8}.ds-crew{display:block;font-size:11.5px;color:#78829B}.ds-slot.is-hold{border:1px dashed rgba(255,217,143,.55);background:rgba(255,217,143,.04);color:#FFD98F}.ds-slot.is-new{background:#FFD98F;border-color:#FFD98F;color:#1A1304}"
    },
    {
      "name": "Top bar",
      "kind": "nav",
      "refersTo": "pill-text",
      "description": "Company line with subline and a text-message pill.",
      "html": "<header class=\"ds-top\"><div><div class=\"ds-co\">Falls City Light Co.</div><div class=\"ds-sub\">Prepared for Sarah &amp; Tom Whitfield · Quote FCL-2041</div></div><a class=\"ds-pill\" href=\"#\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linejoin=\"round\"><path d=\"M1.5 2.5h11v7h-6l-3 2.5v-2.5h-2z\"/></svg>Text Dale Whitaker</a></header>",
      "css": ".ds-top{height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 24px;border-bottom:1px solid rgba(238,241,248,.07);background:#070A14;font-family:Archivo,Helvetica Neue,Arial,sans-serif;color:#EEF1F8}.ds-co{font-weight:600;font-size:15px}.ds-sub{font-size:12.5px;color:#78829B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-pill{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border:1px solid rgba(238,241,248,.12);border-radius:999px;font-size:13px;font-weight:500;text-decoration:none;color:#A6AEC2;transition:border-color .2s,color .2s}.ds-pill:hover{border-color:#78829B;color:#EEF1F8}"
    }
  ],
  "narrative": {
    "northStar": "The Night Elevation",
    "overview": "Prism's product surfaces live at night. The ground is the color of a blue-hour sky after the photo has been relit; text is cool ink; the only warm color is lamp-white, and lamp-white always means on. Gambetta speaks for the homeowner in one line per screen; Archivo carries every number. Motion is one orchestrated entrance per screen plus one signature interaction: the tier dial relights the house, rolls the price, and lights the scope in sequence.",
    "keyCharacteristics": ["Lamp means on", "One lit button per screen", "Sky-tinted ground, two hairlines", "Serif voice, tabular sans for numbers", "Crossfade, never reflow"],
    "rules": [
      { "name": "Lamp means on", "body": "Lamp-white marks included, earned, selected, or ready to press. Never emphasis or ornament.", "section": "colors" },
      { "name": "One lit button", "body": "The selected dial segment is a wash with a hairline so the approve button is the only fully lit object.", "section": "colors" },
      { "name": "Quantities are data, states are words", "body": "Footage and counts are tabular Archivo; 'Included' is a quiet word in ink-3.", "section": "typography" },
      { "name": "Glow only on lamp", "body": "A colored glow is permitted only around lamp-colored objects, as the lamp's own light.", "section": "elevation" }
    ],
    "dos": ["Light things that are on; leave everything else dark.", "Put footage, counts, and dates next to every claim.", "Crossfade; never reflow. The render slot is 3:2 forever.", "Write fine print as reassurance."],
    "donts": ["Don't use a second warm color, a gradient sky, or lamp as decoration.", "Don't strike through what a tier excludes; show what the next tier adds.", "Don't stack equal cards in a grid; separate rows with hairlines.", "Don't set uppercase labels above headlines.", "Don't let a chart stand in for a sentence."]
  }
